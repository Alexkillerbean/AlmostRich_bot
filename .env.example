# Скопируйте этот файл в .env и заполните значения.
# Файл .env НЕ коммитить в git.

# Токен от @BotFather. Если старый токен попадал в открытый доступ — отзовите через /revoke.
BOT_TOKEN=123456:ABC-DEF...

# Канал: @username (без @ тоже работает) или числовой ID вида -100xxxxxxxxxx.
# Бот должен быть добавлен в канал администратором.
CHANNEL_ID=@AlmostRich

# URL мини-аппа калькулятора (по нему WebApp-кнопка открывает приложение).
WEB_APP_URL=https://your-app.example.com

# Папка для базы (необязательно). На bothost уже задан постоянный том /app/data.
# DATA_DIR=/app/data
